# Stripe
# Painel Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...

# Painel Stripe → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs de preço criados no painel Stripe → Products
# Pro Mensal: R$130/mês
STRIPE_PRICE_PRO_MONTHLY=price_...
# Pro Anual: R$1.188/ano (cobrado de uma vez)
STRIPE_PRICE_PRO_ANNUAL=price_...
# Agency Mensal: R$250/mês
STRIPE_PRICE_AGENCY_MONTHLY=price_...
# Agency Anual: R$2.040/ano (cobrado de uma vez)
STRIPE_PRICE_AGENCY_ANNUAL=price_...

# Email
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cron
CRON_SECRET=

# Superadmin (emails autorizados para /admin)
SUPERADMIN_EMAILS=
